{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-theme-rose-ink",
  "version": "1.1.2",
  "description": "A warm taupe theme with rose accents, cyan charts, and 14px text; supports light and dark modes.",
  "license": "MIT",
  "repository": "https://github.com/BANG404/openagent-theme-rose-ink",
  "homepage": "https://ui.shadcn.com/create",
  "keywords": [
    "theme",
    "shadcn",
    "sera",
    "taupe",
    "rose"
  ],
  "extensions": {
    "openagent": {
      "type": "theme",
      "compatibility": {
        "plugin_protocol": {
          "min": 1,
          "max": 1
        },
        "features": [
          "theme-v1",
          "theme-fonts-v1"
        ]
      },
      "theme": {
        "version": 1,
        "tokens": {
          "--font-sans": "'Noto Sans Variable', sans-serif",
          "--app-font-family": "var(--font-sans)",
          "--font-heading": "'Playfair Display Variable', serif",
          "--radius": "0.25rem",
          "--app-font-size": "14px",
          "--settings-control-height": "36px",
          "--control-height": "36px",
          "--control-padding-inline": "16px",
          "--menu-item-min-height": "32px",
          "--menu-item-font-size": "13px",
          "--menu-item-padding-inline": "16px",
          "--settings-card-row-padding-block": "16px",
          "--plugin-card-padding": "16px",
          "--settings-content-padding": "32px",
          "--sidebar-selected": "var(--sidebar-accent)",
          "--sidebar-selected-foreground": "var(--sidebar-accent-foreground)"
        },
        "light": {
          "--background": "oklch(1 0 0)",
          "--foreground": "oklch(0.147 0.004 49.3)",
          "--card": "oklch(1 0 0)",
          "--card-foreground": "oklch(0.147 0.004 49.3)",
          "--popover": "oklch(1 0 0)",
          "--popover-foreground": "oklch(0.147 0.004 49.3)",
          "--primary": "oklch(0.514 0.222 16.935)",
          "--primary-foreground": "oklch(0.969 0.015 12.422)",
          "--secondary": "oklch(0.967 0.001 286.375)",
          "--secondary-foreground": "oklch(0.21 0.006 285.885)",
          "--muted": "oklch(0.96 0.002 17.2)",
          "--muted-foreground": "oklch(0.547 0.021 43.1)",
          "--accent": "oklch(0.96 0.002 17.2)",
          "--accent-foreground": "oklch(0.214 0.009 43.1)",
          "--destructive": "oklch(0.577 0.245 27.325)",
          "--border": "oklch(0.922 0.005 34.3)",
          "--input": "oklch(0.922 0.005 34.3)",
          "--ring": "oklch(0.714 0.014 41.2)",
          "--chart-1": "oklch(0.865 0.127 207.078)",
          "--chart-2": "oklch(0.715 0.143 215.221)",
          "--chart-3": "oklch(0.609 0.126 221.723)",
          "--chart-4": "oklch(0.52 0.105 223.128)",
          "--chart-5": "oklch(0.45 0.085 224.283)",
          "--sidebar": "oklch(0.986 0.002 67.8)",
          "--sidebar-foreground": "oklch(0.147 0.004 49.3)",
          "--sidebar-primary": "oklch(0.586 0.253 17.585)",
          "--sidebar-primary-foreground": "oklch(0.969 0.015 12.422)",
          "--sidebar-accent": "oklch(0.90 0.002 17.2)",
          "--sidebar-accent-foreground": "oklch(0.214 0.009 43.1)",
          "--sidebar-border": "oklch(0.922 0.005 34.3)",
          "--sidebar-ring": "oklch(0.714 0.014 41.2)",
          "--menu-surface": "color-mix(in srgb, var(--foreground) 85%, transparent)",
          "--menu-foreground": "var(--background)",
          "--menu-accent": "color-mix(in srgb, var(--background) 15%, transparent)",
          "--menu-accent-foreground": "var(--menu-foreground)"
        },
        "dark": {
          "--background": "oklch(0.147 0.004 49.3)",
          "--foreground": "oklch(0.986 0.002 67.8)",
          "--card": "oklch(0.214 0.009 43.1)",
          "--card-foreground": "oklch(0.986 0.002 67.8)",
          "--popover": "oklch(0.214 0.009 43.1)",
          "--popover-foreground": "oklch(0.986 0.002 67.8)",
          "--primary": "oklch(0.455 0.188 13.697)",
          "--primary-foreground": "oklch(0.969 0.015 12.422)",
          "--secondary": "oklch(0.274 0.006 286.033)",
          "--secondary-foreground": "oklch(0.985 0 0)",
          "--muted": "oklch(0.268 0.011 36.5)",
          "--muted-foreground": "oklch(0.714 0.014 41.2)",
          "--accent": "oklch(0.268 0.011 36.5)",
          "--accent-foreground": "oklch(0.986 0.002 67.8)",
          "--destructive": "oklch(0.704 0.191 22.216)",
          "--border": "oklch(1 0 0 / 10%)",
          "--input": "oklch(1 0 0 / 15%)",
          "--ring": "oklch(0.547 0.021 43.1)",
          "--chart-1": "oklch(0.865 0.127 207.078)",
          "--chart-2": "oklch(0.715 0.143 215.221)",
          "--chart-3": "oklch(0.609 0.126 221.723)",
          "--chart-4": "oklch(0.52 0.105 223.128)",
          "--chart-5": "oklch(0.45 0.085 224.283)",
          "--sidebar": "oklch(0.21 0.006 285.885)",
          "--sidebar-foreground": "oklch(0.986 0.002 67.8)",
          "--sidebar-primary": "oklch(0.645 0.246 16.439)",
          "--sidebar-primary-foreground": "oklch(0.969 0.015 12.422)",
          "--sidebar-accent": "oklch(0.36 0.011 36.5)",
          "--sidebar-accent-foreground": "oklch(0.986 0.002 67.8)",
          "--sidebar-border": "oklch(1 0 0 / 10%)",
          "--sidebar-ring": "oklch(0.547 0.021 43.1)",
          "--menu-surface": "color-mix(in srgb, var(--foreground) 85%, transparent)",
          "--menu-foreground": "var(--background)",
          "--menu-accent": "color-mix(in srgb, var(--background) 15%, transparent)",
          "--menu-accent-foreground": "var(--menu-foreground)"
        },
        "fonts": [
          {
            "family": "Noto Sans Variable",
            "entry": "fonts/noto-sans.woff2",
            "weight": "100 900",
            "style": "normal"
          },
          {
            "family": "Playfair Display Variable",
            "entry": "fonts/playfair-display.woff2",
            "weight": "100 900",
            "style": "normal"
          }
        ]
      },
      "i18n": {
        "supported_locales": [
          "en",
          "zh"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Rose Ink Rose Theme",
            "description": "A warm taupe theme with rose accents, cyan charts, and 14px text; supports light and dark modes."
          },
          "zh": {
            "display_name": "Rose Ink 玫瑰主题",
            "description": "暖灰褐底色，搭配玫瑰强调色、青色图表和 14px 字号，支持浅色与深色模式。"
          }
        }
      },
      "category": "design"
    }
  }
}
